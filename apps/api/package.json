{
  "name": "@finflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "FinFlow REST API (NestJS)",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/database/cli.js migrate",
    "db:seed": "node dist/database/cli.js seed",
    "test:coverage": "vitest run --config vitest.config.e2e.ts --coverage"
  },
  "dependencies": {
    "@finflow/shared": "workspace:*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.2",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "type": "module"
}
